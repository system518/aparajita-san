---
---
<section class="content-gap hero">
  <div class="container row-2col">
    <div class="copy">
      <div class="sec-header">
        <h2>SALUTING<br /><span>womanhood</span></h2>
      </div>
      <p>
        <em>Tell your story. It deserves to be heard</em>.<br />
        Under the aegis of <b>Sanmarg</b>, the largest and most widely read Hindi daily in
        Eastern India, Aparajita is a programme that supports outstanding work by women and
        amplifies their stories.
      </p>
      <a href="/overview">
        <div class="custom-button button-active">
          <div class="btn-text">Learn More</div>
          <div class="btn-arrow"><span>→</span></div>
        </div>
      </a>
    </div>

    <div class="art">
      <img class="kite" src="/images/who-is-Aparajita.webp" alt="" />
    </div>
  </div>
</section>

<style>
  .hero { padding-top: 60px; }
  .sec-header h2 {
    margin: 15px 0 30px !important;
    font-size: 38px;
    letter-spacing: 0.02em;
  }
  .sec-header h2 span { font-size: 52px; letter-spacing: 0; }
  .copy p { max-width: 46ch; }
  .copy em { font-style: italic; }

  .art { position: relative; text-align: center; }
  .kite {
    display: block;
    margin: 0 auto;
    width: 100%;
    max-width: 420px;
    animation: fadeInDown 1s ease 0.4s both;
  }

  @keyframes fadeInDown {
    from { opacity: 0; transform: translateY(-24px); }
    to { opacity: 1; transform: none; }
  }
</style>
