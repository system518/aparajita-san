---
import { menu, socials, navLinks } from '../data/site';
import SocialIcon from './SocialIcon.astro';
---

<section class="masthead">
  <div class="head-inner">
    <a class="logo" href="/" title="logo">
      <img src="/images/Aparajita-logo-lg-2026.webp" alt="Aparajita — Saluting Womanhood" />
    </a>

    <nav class="navik-menu" aria-label="Primary">
      <ul>
        {menu.map((item) => (
          <li class={item.children ? 'has-drop' : ''}>
            <a href={item.href}>{item.label}</a>
            {item.children && (
              <ul>
                {item.children.map((child) => (
                  <li class={child.children ? 'has-drop nested' : ''}>
                    <a href={child.href}>{child.label}</a>
                    {child.children && (
                      <ul>
                        {child.children.map((leaf) => (
                          <li><a href={leaf.href}>{leaf.label}</a></li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <button class="burger-menu" type="button" aria-expanded="false" aria-controls="overlay-menu" data-burger>
      <span class="visually-hidden">Menu</span>
      <span class="line line-half first-line"></span>
      <span class="line"></span>
      <span class="line line-half last-line"></span>
    </button>
  </div>
</section>

<div class="menu-overlay" id="overlay-menu" data-overlay hidden>
  <ul class="overlay-list">
    {menu.map((item) => (
      <li>
        <a href={item.href}>{item.label}</a>
        {item.children && (
          <ul>
            {item.children.map((child) => (
              <li>
                <a href={child.href}>{child.label}</a>
                {child.children && (
                  <ul>
                    {child.children.map((leaf) => <li><a href={leaf.href}>{leaf.label}</a></li>)}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ul>

  <div class="menu-footer">
    <div class="social-icons">
      {socials.map((social) => (
        <a href={social.href} target="_blank" rel="noopener" aria-label={social.label}>
          <SocialIcon icon={social.icon} />
        </a>
      ))}
    </div>
    <div class="nav-links">
      <a href="/aagekaun">NOMINATE</a>
      <a href="https://aparajitavoting.sanmarg.in/usersignup" target="_blank" rel="noopener">VOTE NOW</a>
      <a href="/contact-us">CONTACT</a>
    </div>
  </div>
</div>

<style>
  .masthead { padding: 26px 60px 0; }
  .head-inner {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
  }
  .logo { display: block; }
  .logo img { width: 260px; }

  .navik-menu > ul {
    display: flex;
    align-items: center;
    gap: 34px;
    list-style: none;
    margin: 0 0 12px;
    padding: 0;
  }
  .navik-menu > ul > li { position: relative; }
  .navik-menu a {
    font-family: var(--font-secondary);
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-default);
    white-space: nowrap;
  }
  .navik-menu a:hover { color: var(--color-secondary); }
  .has-drop > a::after {
    content: '';
    display: inline-block;
    margin-left: 7px;
    border: 4px solid transparent;
    border-top-color: currentColor;
    transform: translateY(2px);
  }

  .navik-menu ul ul {
    position: absolute;
    top: 100%;
    left: -20px;
    min-width: 250px;
    list-style: none;
    margin: 14px 0 0;
    padding: 8px 0;
    background: #fff;
    border-top: 2px solid var(--color-secondary);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.1);
    opacity: 0;
    visibility: hidden;
    transform: scale(0.98);
    transform-origin: top;
    transition: all 0.25s ease;
    z-index: 40;
  }
  .navik-menu li:hover > ul,
  .navik-menu li:focus-within > ul { opacity: 1; visibility: visible; transform: scale(1); }
  .navik-menu ul ul li { position: relative; }
  .navik-menu ul ul a { display: block; padding: 9px 22px; text-transform: none; font-size: 14px; letter-spacing: 0; }
  .navik-menu ul ul ul { top: 0; left: 100%; margin: 0; }

  /* icon geometry + open animation mirror the live navik menu on aparajita.sanmarg.in */
  .burger-menu {
    display: none;
    position: relative;
    z-index: 100;
    flex-direction: column;
    justify-content: space-between;
    width: 20px;
    height: 17px;
    padding: 0;
    margin-bottom: 14px;
    background: none;
    border: 0;
    cursor: pointer;
    transition: transform 330ms ease-out;
    -webkit-tap-highlight-color: transparent;
  }
  /* 20x17 is below the 44px tap target, so grow the hit area without moving the icon */
  .burger-menu::before {
    content: '';
    position: absolute;
    inset: -14px -15px;
  }
  .burger-menu .line {
    display: block;
    width: 100%;
    height: 2px;
    background-color: var(--color-default);
    border-radius: 2px;
  }
  .burger-menu .line-half { width: 50%; }
  .burger-menu .first-line {
    transform-origin: right;
    transition: transform 330ms cubic-bezier(0.54, -0.81, 0.57, 0.57);
  }
  .burger-menu .last-line {
    align-self: flex-end;
    transform-origin: left;
    transition: transform 330ms cubic-bezier(0.54, -0.81, 0.57, 0.57);
  }

  /* halves swing vertical to form a plus, the button rotates it into an X */
  .burger-menu[aria-expanded='true'] { transform: rotate(-45deg); }
  .burger-menu[aria-expanded='true'] .first-line { transform: rotate(-90deg) translateX(3px); }
  .burger-menu[aria-expanded='true'] .last-line { transform: rotate(-90deg) translateX(-3px); }

  @media (prefers-reduced-motion: reduce) {
    .burger-menu, .burger-menu .line { transition: none; }
  }

  .visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .menu-overlay {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: #f4f2ec;
    padding: 100px 22px calc(40px + env(safe-area-inset-bottom));
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
  }
  .overlay-list, .overlay-list ul { list-style: none; margin: 0; padding: 0; }
  .overlay-list > li { border-bottom: 1px solid #e8e7e8; }
  .overlay-list > li:last-child { border-bottom: 0; }
  .overlay-list > li > a {
    display: block;
    padding: 14px 0;
    font-family: var(--font-primary);
    font-size: 30px;
    line-height: 1.2;
    color: var(--color-default);
    text-transform: none;
  }
  .overlay-list ul { padding: 0 0 14px 16px; }
  .overlay-list ul a { display: block; padding: 6px 0; font-size: 17px; color: #454b4f; }
  .menu-footer {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid rgba(0, 0, 0, 0.12);
    display: flex;
    flex-wrap: wrap;
    gap: 26px;
    justify-content: space-between;
  }
  .social-icons, .nav-links { display: flex; flex-wrap: wrap; gap: 20px; align-items: center; }
  .social-icons a, .nav-links a { color: var(--color-default); font-size: 13px; letter-spacing: 0.1em; }
  .social-icons a:hover, .nav-links a:hover { color: var(--color-secondary); }

  @media (max-width: 1199px) {
    .navik-menu { display: none; }
    .burger-menu { display: flex; }
    /* keep the button clickable above the overlay so it can close the menu */
    .masthead { position: relative; z-index: 100; padding: 20px 22px 0; }
    .head-inner { align-items: center; gap: 20px; }
    .logo img { width: 190px; }
  }

  @media (max-width: 575px) {
    .masthead { padding: 16px 18px 0; }
    .menu-overlay { padding-top: 84px; padding-left: 18px; padding-right: 18px; }
    .logo img { width: 150px; }
    .overlay-list > li > a { font-size: 24px; padding: 11px 0; }
    .menu-footer { flex-direction: column; align-items: flex-start; gap: 18px; }
  }
</style>

<script>
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const overlay = document.querySelector<HTMLElement>('[data-overlay]');

  const setOpen = (open: boolean) => {
    burger?.setAttribute('aria-expanded', String(open));
    if (overlay) overlay.hidden = !open;
    document.body.style.overflow = open ? 'hidden' : '';
  };

  burger?.addEventListener('click', () => setOpen(burger.getAttribute('aria-expanded') !== 'true'));
  overlay?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });

  // desktop nav returns at >=1200px — make sure a stale open overlay doesn't lock scrolling
  const desktop = window.matchMedia('(min-width: 1200px)');
  desktop.addEventListener('change', (e) => { if (e.matches) setOpen(false); });
</script>
