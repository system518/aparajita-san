<section class="content-gap" id="akaar">
  <div class="container row-2col">
    <div class="shot">
      <img src="/images/Akaar-Image.webp" alt="Akaar — women social entrepreneurs" loading="lazy" />
    </div>

    <div class="copy">
      <p class="eyebrow">Akaar: A Movement</p>
      <h2 class="display-4">Uplifting and supporting women social entrepreneurs from rural areas</h2>
      <p class="body">
        Join our small endeavour – we're bringing the gritty stories of women entrepreneurs
        from rural West Bengal and Bihar out from the shadows.
      </p>
      <a href="/akaar">
        <div class="custom-button">
          <div class="btn-text">Join The Movement</div>
          <div class="btn-arrow"><span>→</span></div>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  .shot img { width: 100%; display: block; }
  .copy h2 { margin-bottom: 26px !important; }
  .body { max-width: 42ch; }
</style>
