---
import { socials, navLinks } from '../data/site';
import SocialIcon from './SocialIcon.astro';
const year = new Date().getFullYear();
---

<div class="footer-bar">
  <div class="social-icons">
    {socials.map((social) => (
      <a href={social.href} target="_blank" rel="noopener" aria-label={social.label}>
        <SocialIcon icon={social.icon} />
      </a>
    ))}
  </div>
  <div class="nav-links">
    {navLinks.map((link) => <a href={link.href}>{link.label.toUpperCase()}</a>)}
  </div>
</div>

<section class="cpyr8">
  <p>© {year} Sanmarg. All Rights Reserved.</p>
</section>

<style>
  .footer-bar {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 50px;
    padding: 18px 24px;
    border-top: 1px solid rgba(0, 0, 0, 0.15);
  }
  .social-icons, .nav-links { display: flex; gap: 20px; align-items: center; }
  .social-icons a, .nav-links a {
    color: var(--color-default);
    font-size: 13px;
    letter-spacing: 0.06em;
    display: inline-flex;
  }
  .social-icons a:hover, .nav-links a:hover { color: var(--color-secondary); }

  .cpyr8 { background-color: #333; }
  .cpyr8 p {
    text-align: center;
    color: #fff;
    font-size: 14px;
    letter-spacing: 0.1rem;
    margin: 0;
    padding: 15px;
  }

  @media (max-width: 575px) {
    .footer-bar { gap: 24px; flex-wrap: wrap; }
  }
</style>
