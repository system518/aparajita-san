---
import Base from '../layouts/Base.astro';
---

<Base title="Contact Us — Sanmarg : Aparajita" description="Contact Us — Aparajita, an initiative by Sanmarg.">
<section>
        <div class="container sec-pad">
            <div class="row d-flex align-items-center">
                <div class="col-sm-12">
                    <span class="inside-header">
                        <h1>Contact Us</h1>
                    </span>
                </div>
            </div>
        </div>
    </section>
    <section class="sec-pad">
        <div class="container">
            <div class="row">
                <div class="col-sm-10 mx-auto">
                    <h3 class="text-center hindi-font fw-bold quote-font">अनसुनी कहानियाँ, अनकहे किससे &#8211; <span>अपराजिता</span> सुनने को हमेशा तत्पर है।</h3>
                </div>
            </div>
        </div>
    </section>
    <div class="container">
        <div class="row">
            <div class="col-sm-2 mx-auto"><img src="/images/contact-motif.webp" class="img-fluid img-50 d-flex mx-auto" alt="Aparajita Flower"></div>
        </div>
    </div>
        <section class="sec-pad">
           <div class="container">
            <div class="row">
                <div class="col-sm-12 sec-header">
                    <h3 class="text-center"><span>Aparajita</span> is a family that cares for her tribe.</h3>
                </div>
                <div class="col-sm-12">
                    <p class="text-center mt-3">For queries, to cast a nomination for Aage Kaun, or to get in touch with our team, please reach out over email at
                    </p>
                    <p class="contact-hilit"><a href="mailto:aparajita@sanmarg.in">aparajita@sanmarg.in</a></p>
                    <p class="contact-hilit">+91 98302 22232</p>
                    <p class="contact-hilit">Sanmarg Bhawan, 160B, Chittaranjan Avenue, Kolkata &#8211; 700007</p>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-6 mt-5 mx-auto d-flex justify-content-center align-items-center">
                    <p class="contact-nominate"><a href="/aagekaun">Click Here</a> to nominate an Aparajita</p>
                </div>
                <div class="col-sm-12 mt-5">
                    <div class=" social-icon-area">
                        <ul>
                            <li><a href="https://www.linkedin.com/company/aparajita/" target="_blank" rel="noopener"><img src="/images/pngwing.com-60.webp" class="img-fluid" alt="linkedin"> </a></li>
                            <li><a href="https://www.facebook.com/sanmargaparajita/" target="_blank" rel="noopener"><img src="/images/pngwing.com-58.webp" class="img-fluid" alt="facebook"></a></li>
                            <li><a href="https://www.instagram.com/sanmarg.aparajita/?hl=en" target="_blank" rel="noopener"><img src="/images/pngwing.com-61.webp" class="img-fluid" alt="instagram"></a></li>
                            <li><a href="https://www.youtube.com/channel/UCsjKQb2YbXyvVQsKzOQBeYg" target="_blank" rel="noopener"><img src="/images/youtube-Photoroom.webp" class="img-fluid" alt="youtube"></a></li>
                        </ul>
                    </div>
                </div>
            </div>
            </div>
        </section>
        <section class="sec-pad">
            <div class="container">
                <div class="row">
                    <div class="col-sm-6 mx-auto aparajita-flwr">
                        <p class="text-center">
                            <b>The floral element used across this website are of the <span>Aparajita</span> flower &#8211;</b> with petals known for their softness, and a colour that leaves an indelible mark on everything it touches.
                        </p>
                    </div>
                </div>
            </div>
        </section>
<p class="wp-block-paragraph"></p>
</Base>
