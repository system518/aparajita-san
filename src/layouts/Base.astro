---
import '../styles/global.css';
import '../styles/pages.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/images/cropped-android-chrome-192x192-1.webp" />
    <link rel="icon" href="/images/cropped-android-chrome-192x192-1-32x32.webp" />
    <link rel="apple-touch-icon" href="/images/cropped-android-chrome-192x192-1-180x180.webp" />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      // accordions ported from the original archive / FAQ sections
      document.querySelectorAll<HTMLButtonElement>('.accordion-button').forEach((button) => {
        const id = button.getAttribute('aria-controls');
        const panel = id ? document.getElementById(id) : null;
        if (!panel) return;

        // The ported markup carries a stale aria-expanded on some buttons;
        // the panel's own "show" class is what decided the state originally.
        const open = panel.classList.contains('show');
        button.setAttribute('aria-expanded', String(open));
        button.classList.toggle('collapsed', !open);

        button.addEventListener('click', () => {
          const isOpen = panel.classList.toggle('show');
          button.setAttribute('aria-expanded', String(isOpen));
          button.classList.toggle('collapsed', !isOpen);
        });
      });
    </script>

    <script>
      // ---- profile modals -------------------------------------------------
      // Cards expose a name only; each modal carries the matching title.
      // Link them by normalised name so "View profile" opens the right one.
      const normalise = (value: string) =>
        value.replace(/[^a-z0-9]+/gi, ' ').trim().toLowerCase();

      const modals = Array.from(document.querySelectorAll<HTMLElement>('.modal'));

      const closeModal = (modal: HTMLElement) => {
        modal.classList.remove('show');
        modal.setAttribute('aria-hidden', 'true');
        if (!document.querySelector('.modal.show')) {
          document.body.classList.remove('modal-open');
        }
      };

      const openModal = (modal: HTMLElement) => {
        modal.classList.add('show');
        modal.setAttribute('aria-hidden', 'false');
        document.body.classList.add('modal-open');
      };

      modals.forEach((modal) => {
        modal.querySelectorAll<HTMLButtonElement>('.modal-header .btn').forEach((button) => {
          button.setAttribute('aria-label', 'Close');
          button.addEventListener('click', () => closeModal(modal));
        });
        modal.addEventListener('click', (event) => {
          if (event.target === modal) closeModal(modal);
        });
      });

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        document.querySelectorAll<HTMLElement>('.modal.show').forEach(closeModal);
      });

      document.querySelectorAll<HTMLAnchorElement>('.view-profile').forEach((link) => {
        const card = link.closest<HTMLElement>('[class*="col-"]');
        const name = card?.querySelector('.name')?.textContent;
        if (!name) {
          link.remove();
          return;
        }

        // Prefer a modal from the same year block before falling back to the page.
        const scope = link.closest<HTMLElement>('.accordion-body') ?? document.body;
        const wanted = normalise(name);
        const match =
          modals.find(
            (modal) =>
              scope.contains(modal) &&
              normalise(modal.querySelector('.modal-title')?.textContent ?? '') === wanted
          ) ??
          modals.find(
            (modal) => normalise(modal.querySelector('.modal-title')?.textContent ?? '') === wanted
          );

        if (!match) {
          link.remove();
          return;
        }

        link.textContent = 'i';
        link.setAttribute('role', 'button');
        link.setAttribute('tabindex', '0');
        link.setAttribute('title', `About ${name.trim()}`);
        link.setAttribute('aria-label', `About ${name.trim()}`);
        link.addEventListener('click', (event) => {
          event.preventDefault();
          openModal(match);
        });
        link.addEventListener('keydown', (event) => {
          if (event.key !== 'Enter' && event.key !== ' ') return;
          event.preventDefault();
          openModal(match);
        });
      });

      // ---- category filters ----------------------------------------------
      // Labels and card categories are worded loosely ("Community Service" vs
      // "(Community Service & Advocacy)"), so match on containment, and read the
      // category from .category where present and .deg on the older year blocks.
      const categoryKey = (value: string) =>
        normalise(value).replace(/\band\b/g, ' ').replace(/\s+/g, ' ').trim();

      const allElements = Array.from(document.querySelectorAll<HTMLElement>('*'));

      document.querySelectorAll<HTMLSelectElement>('select[id^="selectOption"]').forEach((select) => {
        // Duplicate ids repeat across year blocks, so take the next "show..."
        // block in document order rather than looking one up by id.
        const from = allElements.indexOf(select);
        const list = allElements.find(
          (element, index) => index > from && element.id.startsWith('show')
        );
        if (!list) return;

        const cards = Array.from(list.querySelectorAll<HTMLElement>('[class*="col-"]')).filter(
          (card) => card.querySelector('.name')
        );
        if (!cards.length) return;

        const categoryOf = (card: HTMLElement) =>
          categoryKey(card.querySelector('.category')?.textContent ?? card.querySelector('.deg')?.textContent ?? '');

        select.addEventListener('change', () => {
          const label = (select.options[select.selectedIndex]?.text ?? '').trim();
          const wanted = categoryKey(label);
          const showAll = !wanted || /^(all|select)\b/i.test(label);

          cards.forEach((card) => {
            const category = categoryOf(card);
            const hit = showAll || (category !== '' && (category.includes(wanted) || wanted.includes(category)));
            card.classList.toggle('hidden', !hit);
          });
        });
      });

      // ---- Akaar featured-story cards --------------------------------------
      // Same nav treatment as the photo carousels below, but the track is the
      // ported .slide_track rather than a tile grid.
      document.querySelectorAll<HTMLElement>('.slider_div').forEach((carousel) => {
        const track = carousel.querySelector<HTMLElement>('.slide_track');
        if (!track || track.children.length < 2) return;

        const prev = document.createElement('button');
        prev.type = 'button';
        prev.className = 'gallery-nav prev';
        prev.setAttribute('aria-label', 'Previous stories');

        const next = document.createElement('button');
        next.type = 'button';
        next.className = 'gallery-nav next';
        next.setAttribute('aria-label', 'Next stories');

        carousel.append(prev, next);

        const step = () => {
          const first = track.firstElementChild as HTMLElement | null;
          return first ? first.getBoundingClientRect().width + 30 : track.clientWidth;
        };

        const sync = () => {
          const max = track.scrollWidth - track.clientWidth - 1;
          prev.disabled = track.scrollLeft <= 0;
          next.disabled = track.scrollLeft >= max;
        };

        prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
        next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
        track.addEventListener('scroll', sync, { passive: true });
        window.addEventListener('resize', sync);
        new ResizeObserver(sync).observe(track);
        sync();

        // Advance one card every few seconds, right to left, wrapping at the
        // end. Paused while the pointer or keyboard focus is in the carousel so
        // it never slides a story out from under someone reading it, and off
        // entirely for visitors who ask for reduced motion.
        const stillMoving = window.matchMedia('(prefers-reduced-motion: reduce)');
        if (stillMoving.matches) return;

        let timer = 0;
        const advance = () => {
          const max = track.scrollWidth - track.clientWidth - 1;
          if (track.scrollLeft >= max) {
            track.scrollTo({ left: 0, behavior: 'smooth' });
          } else {
            track.scrollBy({ left: step(), behavior: 'smooth' });
          }
        };
        const play = () => {
          if (!timer) timer = window.setInterval(advance, 4000);
        };
        const pause = () => {
          window.clearInterval(timer);
          timer = 0;
        };

        carousel.addEventListener('mouseenter', pause);
        carousel.addEventListener('mouseleave', play);
        carousel.addEventListener('focusin', pause);
        carousel.addEventListener('focusout', play);
        carousel.addEventListener('touchstart', pause, { passive: true });
        // Nothing to advance to while the section is off screen.
        new IntersectionObserver(
          ([entry]) => (entry.isIntersecting ? play() : pause()),
          { threshold: 0 }
        ).observe(carousel);
      });

      // ---- photo carousels -------------------------------------------------
      // Caption-less tile grids are the ceremony / meet photo galleries; the
      // captioned ones are people listings and stay as grids.
      document.querySelectorAll<HTMLElement>('ul.tile-grid').forEach((grid) => {
        if (grid.querySelector('figcaption')) return;
        const slides = grid.children.length;
        if (slides < 2) return;

        const carousel = document.createElement('div');
        carousel.className = 'gallery-carousel';
        grid.parentNode?.insertBefore(carousel, grid);
        carousel.appendChild(grid);

        const prev = document.createElement('button');
        prev.type = 'button';
        prev.className = 'gallery-nav prev';
        prev.setAttribute('aria-label', 'Previous photos');

        const next = document.createElement('button');
        next.type = 'button';
        next.className = 'gallery-nav next';
        next.setAttribute('aria-label', 'Next photos');

        carousel.append(prev, next);

        const step = () => {
          const first = grid.firstElementChild as HTMLElement | null;
          return first ? first.getBoundingClientRect().width + 20 : grid.clientWidth;
        };

        const sync = () => {
          const max = grid.scrollWidth - grid.clientWidth - 1;
          prev.disabled = grid.scrollLeft <= 0;
          next.disabled = grid.scrollLeft >= max;
        };

        prev.addEventListener('click', () => grid.scrollBy({ left: -step(), behavior: 'smooth' }));
        next.addEventListener('click', () => grid.scrollBy({ left: step(), behavior: 'smooth' }));
        grid.addEventListener('scroll', sync, { passive: true });
        window.addEventListener('resize', sync);
        // Panels start collapsed, so measure once they are actually laid out.
        new ResizeObserver(sync).observe(grid);
        sync();
      });
    </script>
  </body>
</html>
